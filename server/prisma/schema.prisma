generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique @db.VarChar(255)
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Mob {
  id         String   @id
  name       String
  title      String
  region     String
  type       String
  difficulty String
  alignment  String
  element    String
  imageUrl   String?
  shortLore  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Champion {
  id          String   @id
  name        String
  title       String
  role        String
  element     String
  imageUrl    String?
  description String
  abilities   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Boss {
  id         String   @id
  name       String
  title      String
  region     String
  phaseCount Int      @default(1)
  difficulty String
  alignment  String
  elements   String
  role       String
  imageUrl   String?
  shortLore  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Npc {
  id        String   @id
  name      String
  title     String
  region    String
  role      String
  alignment String
  imageUrl  String?
  shortLore String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ability {
  id         String   @id
  name       String
  title      String
  region     String
  type       String
  difficulty String
  alignment  String
  element    String
  imageUrl   String?
  shortLore  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Item {
  id        String   @id
  name      String
  type      String
  slot      String?
  rarity    String
  element   String
  levelReq  Int      @default(1)
  imageUrl  String?
  shortLore String
  stats     String
  effects   String
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Equipment {
  id         String   @id
  name       String
  category   String
  slot       String
  weaponType String?
  rarity     String
  element    String
  levelReq   Int      @default(1)
  imageUrl   String?
  shortLore  String
  stats      String
  effects    String
  synergy    String
  source     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Region {
  id          String   @id
  name        String
  title       String
  description String
  imageUrl    String?
  info        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Faction {
  id          String   @id
  name        String
  continent   String
  country     String
  title       String
  info        String
  description String
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Update {
  id        String   @id
  type      String
  title     String
  date      String
  version   String?
  summary   String
  content   String?
  tags      String
  author    String?
  changes   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
